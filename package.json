{
  "name": "flare-idp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native Identity Provider (OIDC) built on Better Auth, Hono and React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andersro93/flare-idp.git"
  },
  "homepage": "https://github.com/andersro93/flare-idp#readme",
  "bugs": {
    "url": "https://github.com/andersro93/flare-idp/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --cwd apps/idp types && tsc --noEmit -p tsconfig.json",
    "test": "bun run --cwd apps/idp test",
    "test:watch": "bun run --cwd apps/idp test:watch",
    "build": "bun run --cwd apps/idp build",
    "dev": "bun run --cwd apps/idp dev",
    "ci": "bun run check && bun run typecheck && bun run test && bun run build",
    "prepare": "lefthook install",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.10",
    "typescript": "7.0.2"
  }
}
